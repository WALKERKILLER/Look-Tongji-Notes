[Desktop Entry]
Type=Application
Name=Look Studio
GenericName=Lecture Studio
GenericName[zh_CN]=课程回放与笔记
Comment=Watch Tongji lecture replays, transcribe them and take notes with an assistant
Comment[zh_CN]=看同济课程回放、转写文字稿，和助手一起记笔记
Exec=look-studio %U
Icon=cn.lookstudio.look_studio
Terminal=false
Categories=Education;
Keywords=lecture;replay;transcript;notes;Canvas;课程;回放;笔记;
MimeType=x-scheme-handler/lookstudio;
StartupWMClass=cn.lookstudio.look_studio
StartupNotify=true
